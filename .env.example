# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored, so your keys never get committed.

# --- Supabase ---------------------------------------------------------------
# Supabase dashboard → Project Settings → API (or `npx supabase status` locally).
# Both of these are SAFE to expose to the browser: the publishable/anon key
# can only do what Row Level Security policies allow.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# NEVER add the service_role / secret key here or anywhere the browser can see.
# Release 1 does not need it.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
